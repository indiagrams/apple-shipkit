# fastlane/Fastfile
#
# iOS + macOS release pipeline. Modeled on production iOS + macOS shipping
# pipelines used in real App Store submissions.
#
# Usage:
#   make ship   # auto-exports env from .bootstrap.env, then invokes fastlane release tag:v0.1.0
#
# Dry run (no upload, no tag push):
#   fastlane release tag:v0.1.0 skip_upload:true skip_tag:true
#
# What `release` does:
#   1. Build signed iOS .ipa + macOS .pkg via ci/local-release-check.sh
#   2. Upload iOS .ipa to TestFlight (`pilot`)
#   3. Upload macOS .pkg to TestFlight (`pilot`)
#   4. Push the git tag (triggers .github/workflows/release.yml if present)
#
# Prerequisites:
#   - Distribution cert + iOS provisioning profile in login Keychain
#   - macOS provisioning profile + Mac Installer Distribution cert
#   - .bootstrap.env with ASC_API_KEY_ID, ASC_API_KEY_ISSUER_ID, ASC_API_KEY_P8_PATH,
#     FASTLANE_TEAM_ID
#
# Per-platform metadata + submission lanes:
#   fastlane ios upload_metadata     # update iOS App Store record
#   fastlane mac upload_metadata     # update macOS App Store record
#   fastlane ios upload_screenshots  # iOS screenshots
#   fastlane mac upload_screenshots  # macOS screenshots
#   fastlane ios submit_for_review   # submit iOS for App Review
#   fastlane mac submit_for_review   # submit macOS for App Review
#
# Single-command "bump everything for new version":
#   ci/bump-asc-version.sh v0.1.0    # screenshots + version bump + metadata + screenshots

require "shellwords"

# ONE rule about encoding, in ONE place. Every read of a TEXT file in this Fastfile
# goes through read_text; every read of key material goes through read_key_material.
#
# Ruby takes the encoding of a file it reads from the environment. With LANG and
# LC_ALL unset -- normal on a fresh machine, in a cron job, in a bare container --
# Encoding.default_external is US-ASCII, so an unpinned read hands back a String
# tagged US-ASCII whose bytes are not. The read is silent; the strip, the scan or the
# match on the next line raises. The subjects here are not hypothetical: CHANGELOG.md
# carries 300 lines with non-ASCII bytes, fastlane/metadata/copyright.txt carries
# U+00A9, app/project.yml carries 21 such lines and app/Project.swift 11.
#
# fastlane does NOT save you from this. It sets the default external encoding to UTF-8
# only inside its own `sh` helper and restores it afterwards, so reads in this file run
# under whatever the operator's environment supplied -- and in a cleared-locale run it
# prints "WARNING: fastlane requires your locale to be set to UTF-8" and then reads the
# file anyway.
#
# Key material is the exception and gets the binary form rather than a UTF-8 pin;
# transcoding a private key is never what anyone wants. Measured against a throwaway
# P-256 key under both a set and a cleared locale: Spaceship::ConnectAPI::Token.create
# accepts an ASCII-8BIT string and produces a JWT, and JSON.dump round-trips those
# bytes identically. Deliberately NOT require_relative'd from bin/lib: this file has
# exactly one require today, and gaining a load-path dependency would change what
# `make ship` needs on disk.
def read_text(path)
  File.read(path, encoding: "UTF-8")
end

def read_key_material(path)
  File.binread(path)
end

default_platform(:ios)

# In CI mode: provision a temporary keychain for match (via setup_ci) and
# switch match to readonly mode. In local mode: setup_ci must NOT run —
# it creates an isolated temp keychain that codesign would treat as the
# default, hiding the user's login-keychain signing identities and
# producing errSecInternalComponent. Local mode wants codesign to find
# certs in login.keychain-db directly. Always: ensure ASC API token is
# set so any Spaceship calls (BundleId.create, App.create,
# Certificate.delete) authenticate without 2FA.
before_all do
  setup_ci if ENV.fetch("RELEASE_MODE", "local") == "ci"
  asc_api_key
end

# ─── Per-fork identity ────────────────────────────────────────────────────────
#
# APP_NAME + BUNDLE_ID are the only two values that differ between this
# template and any fork made from it. Reading them at lane-resolution time
# from .bootstrap.env (with ENV-var override for CI workflows) keeps this
# entire file byte-equivalent across apple-shipkit, ios-macos-smoketest,
# and every downstream fork.
#
# Resolution chain (first non-nil wins):
#   1. ENV["APP_NAME"]  / ENV["BUNDLE_ID"]   — workflow secrets, manual override
#   2. <repo-root>/.bootstrap.env values     — per-fork tracked config
#   3. Template fallbacks ("HelloApp" / "com.example.helloapp") — fail-loud
#      defaults; if a real ship hits these, the cert / bundle-id lookups
#      against Apple will surface "not registered" immediately.
#
# IOS_SCHEME, MACOS_SCHEME, IPA_NAME_PATTERN and PKG_NAME_PATTERN are NOT
# derived from APP_NAME: the project structure (app/App.xcodeproj, the
# App-iOS / App-macOS schemes, build/App-<version>.ipa) is a constant shared
# by the template and every fork, and only the app's identity — read by the
# build from app/Identity.xcconfig — differs. ci/local-release-check.sh spells
# the same constants. bundle_name still uses APP_NAME (it names the App ID
# at Apple, which is identity, not structure).

def _fork_config
  bootstrap_env = File.join(File.dirname(__FILE__), "..", ".bootstrap.env")
  return {} unless File.exist?(bootstrap_env)
  # The one text read spelled out rather than routed through read_text: the encoding
  # belongs on the same line as the streaming iteration, so a reader (and
  # test/encoding_test.rb) can see the verdict at the site instead of one indirection
  # away. Same spelling Bootstrap::Config.parse uses for the same file.
  File.read(bootstrap_env, encoding: "UTF-8").each_line.each_with_object({}) do |line, h|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    k, v = line.split("=", 2)
    next unless k && v
    # Strip surrounding quotes (env values may be quoted) + drop inline `# …` comments.
    v = v.sub(/\s+#.*\z/, "")
    v = v.gsub(/\A['"]|['"]\z/, "")
    h[k.strip] = v.strip
  end
end

_FORK_CONFIG       = _fork_config

APP_NAME           = ENV["APP_NAME"]  || _FORK_CONFIG["APP_NAME"]  || "HelloApp"
APP_IDENTIFIER     = ENV["BUNDLE_ID"] || _FORK_CONFIG["BUNDLE_ID"] || "com.example.helloapp"
IOS_SCHEME         = "App-iOS"
MACOS_SCHEME       = "App-macOS"
IPA_NAME_PATTERN   = "App-%s.ipa"   # printf with version; written by ci/local-release-check.sh
PKG_NAME_PATTERN   = "App-%s.pkg"

def asc_api_key
  # Decode .p8 to a tmpfile and pass key_filepath instead of key_content +
  # is_key_content_base64. The latter route hits a fastlane 2.233.x bug on
  # macos-15 + Ruby 3.3.11 + OpenSSL 3.6.x where Token.create raises
  # "OpenSSL::PKey::ECError: invalid curve name" inside the action wrapper
  # (despite Spaceship::ConnectAPI::Token.create succeeding when called
  # directly with the same args). The file path route bypasses the buggy
  # gsub + Base64.decode64 path inside the action. See
  # docs/CONTINUOUS-VALIDATION.md G11.
  require "base64"
  require "tmpdir"
  @asc_p8_path ||= begin
    path = File.join(Dir.tmpdir, "asc_api_key_#{ENV.fetch('ASC_API_KEY_ID')}.p8")
    File.write(path, Base64.decode64(ENV.fetch("ASC_API_KEY_P8_BASE64")))
    File.chmod(0600, path)
    # Wipe the decoded .p8 on process exit. Doesn't survive crashes but
    # covers normal exits including UI.user_error!.
    at_exit do
      File.unlink(path) if File.exist?(path)
    rescue StandardError
      # Best-effort; don't blow up the exit path if the file is already
      # gone or unwritable.
    end
    path
  end
  app_store_connect_api_key(
    key_id:       ENV["ASC_API_KEY_ID"],
    issuer_id:    ENV["ASC_API_KEY_ISSUER_ID"],
    key_filepath: @asc_p8_path
  )
end

# Wraps `pilot(...)` in retry-with-exponential-backoff. ASC's altool upload
# step is the most flake-prone in the pipeline (transient TLS resets, slow
# Apple-side processing, sporadic 503s). Without retry, a single transient
# failure on the macOS upload (after iOS already uploaded) leaves the
# release in a half-shipped state with the tag unpushed — most painful when
# diagnosing days later.
#
# Mirrors ci/local-release-check.sh's with_timestamp_retry pattern.
def pilot_with_retry(max_attempts: 3, **opts)
  attempts = 0
  begin
    attempts += 1
    pilot(**opts)
  rescue StandardError => e
    if attempts < max_attempts
      delay = 2**attempts # 2s, 4s, 8s
      UI.important("pilot upload failed (attempt #{attempts}/#{max_attempts}): #{e.message.lines.first&.strip}")
      UI.important("retrying in #{delay}s…")
      sleep(delay)
      retry
    end
    UI.error("pilot upload failed after #{max_attempts} attempts. Last error:")
    UI.error(e.message)
    raise
  end
end

# Translate a string cert type (apple_distribution / apple_development /
# mac_installer_distribution / developer_id_application / developer_id_kext /
# developer_id_installer) into the option hash that fastlane's cert action
# expects.
#
# Why this exists: fastlane's cert action splits cert types across THREE
# different option keys, and getting it wrong fails with a misleading error:
#
#   - `type:` parameter is ONLY valid for the macOS-only types
#     (mac_installer_distribution, developer_id_*). Passing apple_distribution
#     or apple_development as `type:` fails verify_block validation with
#     "Unsupported types, must be: [...]" — the listed types do NOT include
#     the App Store ones, which is the actual fastlane bug-shaped behavior
#     this helper papers over.
#   - `development:` boolean toggles between Apple Distribution (false) and
#     Apple Development (true) certs. Used together with generate_apple_certs.
#   - `generate_apple_certs:` boolean opts into the post-Xcode-11 unified
#     cert types (Apple Distribution / Apple Development) instead of the
#     legacy IOS_DISTRIBUTION / MAC_APP_DISTRIBUTION etc. Default-true on
#     Mac + Xcode 11+, but we set it explicitly for clarity.
#
# Source of truth: cert/options.rb in fastlane 2.230.0 — verify_block at
# line 22-26 enumerates the (limited) valid `type:` values; cert/runner.rb
# certificate_types branches on `type` first, falls through to development +
# generate_apple_certs.
#
# This is the same fix that the v1.5 canary surfaced in #115's mint_local_certs
# lane — `type: "apple_distribution"` had been failing all along; the cold-fork
# validation never actually exercised the auto-mint path with apple_* types.
def cert_options_for_type(type_str)
  case type_str.to_s
  when "apple_distribution"
    { development: false, generate_apple_certs: true }
  when "apple_development"
    { development: true,  generate_apple_certs: true }
  when "mac_installer_distribution", "developer_id_installer",
       "developer_id_application", "developer_id_kext"
    { type: type_str.to_s, platform: "macos" }
  else
    UI.user_error!(
      "Unsupported cert type: #{type_str.inspect}. Valid: apple_distribution, " \
      "apple_development, mac_installer_distribution, developer_id_installer, " \
      "developer_id_application, developer_id_kext."
    )
  end
end

# Build the "What to Test" text for a TestFlight build.
#
# Resolution order:
#   1. `override` (the lane's :changelog option) if non-empty
#   2. ENV["RELEASE_CHANGELOG"] if non-empty
#   3. The first `## [<version>]` block in CHANGELOG.md (skipping a
#      leading empty `[Unreleased]`); empty body falls through
#   4. "Build #{tag} via apple-shipkit" — guaranteed-non-empty fallback
#
# All resolved text is then ASCII-sanitized: ASC's BetaBuildLocalization
# endpoint rejects non-Latin1 in `whatsNew` with a 'contains invalid
# characters' error and `pilot` swallows the response (G15 in
# docs/CONTINUOUS-VALIDATION.md). Common typographic punctuation
# (em/en-dashes, smart quotes, ellipsis, arrows, ✓/✗/⚠) is mapped to
# ASCII fallbacks; anything else outside the 0x20-0x7E range plus
# tab/CR/LF is stripped.
#
# Truncated to 4000 chars (TestFlight's whatsNew limit).
def changelog_text(repo_root, tag, override = nil)
  raw = override.to_s.strip
  raw = ENV["RELEASE_CHANGELOG"].to_s.strip if raw.empty?
  raw = extract_changelog_section(File.join(repo_root, "CHANGELOG.md")).to_s.strip if raw.empty?
  raw = "Build #{tag} via apple-shipkit" if raw.empty?
  ascii_sanitize(raw, max_chars: 4000)
end

# Pull the FIRST non-empty `## [<version>]` block out of CHANGELOG.md.
# Skips a leading `[Unreleased]` IF its body is empty (right after a
# release cut), so the user sees the actual just-released text instead
# of an empty Unreleased shell. Returns nil if the file is missing or
# every block is empty.
def extract_changelog_section(path)
  return nil unless File.exist?(path)
  text = read_text(path)
  # Greedy across blocks; pick the first one with non-empty body.
  text.scan(/^## \[[^\]]+\][^\n]*\n(.*?)(?=^## \[|\z)/m).each do |(body)|
    body = body.to_s.strip
    return body unless body.empty?
  end
  nil
end

# Replace common typographic non-ASCII with ASCII fallbacks; strip the
# rest. Preserves tab/CR/LF (whatsNew accepts newlines). Truncates the
# result to `max_chars`. ASC's whatsNew limit is 4000 chars in 2026;
# truncate at the boundary, do NOT raise — we'd rather ship a trimmed
# annotation than block on a long entry.
def ascii_sanitize(text, max_chars:)
  replacements = {
    "\u2014" => "--", "\u2013" => "-",  "\u2026" => "...",
    "\u2018" => "'",  "\u2019" => "'",
    "\u201C" => '"',  "\u201D" => '"',
    "\u2192" => "->", "\u2190" => "<-",
    "\u2713" => "+",  "\u2717" => "x",  "\u26A0" => "!",
    "\u00A0" => " ",
  }
  out = text.dup
  replacements.each { |from, to| out.gsub!(from, to) }
  out = out.gsub(/[^\x20-\x7E\n\r\t]/, "")
  out.length > max_chars ? out[0, max_chars] : out
end

# Annotate the just-uploaded TestFlight build's BetaBuildLocalization[en-US].whatsNew
# field via direct Spaceship POST/PATCH. Workaround for fastlane pilot
# 2.233.1's broken `set_changelog` (G15 in docs/CONTINUOUS-VALIDATION.md):
# the inner `update_localized_build_review` at pilot/lib/pilot/build_manager.rb
# iterates an empty hash for new builds with no pre-existing BBL, logs
# "Successfully set the changelog" without ever POSTing the localization.
#
# Polls for ASC to register the just-uploaded build records (pilot returns
# ~1-3 min before ASC indexes them into the Build collection). Filters by
# CFBundleShortVersionString (marketing version) AND CFBundleVersion (build
# number) to disambiguate when the same bundle id has multiple shippers
# (e.g. canary cells, multi-dev teams).
#
# Errors are caught and logged as `UI.important` warnings — annotation
# failure does NOT fail the release. The shipping path's primary contract
# is the binary upload; "What to Test" is cosmetic.
#
# Returns nothing meaningful.
# Strip a release tag (with or without leading `v`) into [marketing, build].
# Build is nil when the tag has no `+N` suffix.
#
#   parse_release_tag("v1.0.0+5")             → ["1.0.0", "5"]
#   parse_release_tag("v2026.19.1357")        → ["2026.19.1357", nil]
#   parse_release_tag("v0.2026.19-canary-7")  → ["0.2026.19", nil]
#
# Inlined here (vs. requiring bin/lib/version_resolver.rb) because the
# Fastfile loads in fastlane's own context where load paths are
# unstable across runners. Five-line helper isn't worth the cross-tree
# require headache.
# Mirrors Bootstrap::Version.tag_prefix (bin/lib/version_resolver.rb), which is
# the canonical definition — see its header for why the prefix is configurable at
# all. Duplicated for the same load-path reason as parse_release_tag below.
def release_tag_prefix
  ENV.fetch("RELEASE_TAG_PREFIX", "v")
end

# Strip only the prefix, leaving the rest of the tag untouched. Exactly
# equivalent to the old `sub(/^v/, "")` when the prefix is the default `v`,
# which matters because canary tags carry a `-canary-N` suffix that callers
# still need.
def strip_release_tag_prefix(tag)
  raw = tag.to_s
  pfx = release_tag_prefix
  # Configured prefix first, then a bare `v` so tags cut BEFORE a prefix change
  # stay readable.
  (!pfx.empty? && raw.start_with?(pfx)) ? raw[pfx.length..] : raw.sub(/^v/, "")
end

def parse_release_tag(tag)
  body = strip_release_tag_prefix(tag)
  if body.include?("+")
    body.split("+", 2)
  else
    [body.split("-", 2).first, nil]
  end
end

def annotate_testflight_whats_new(app_identifier:, marketing_version:, ship_start_time:, changelog:, expected_count:)
  require "spaceship"

  Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.create(
    key_id:    ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_KEY_ISSUER_ID"),
    key:       read_key_material(@asc_p8_path),
  )

  app = Spaceship::ConnectAPI::App.find(app_identifier)
  unless app
    UI.important("Annotate: App not found for bundle #{app_identifier}; skipping What to Test.")
    return
  end

  # Filter by ship_start_time, NOT by build_number. ASC/altool can auto-bump
  # CFBundleVersion when a (CFBundleShortVersionString, CFBundleVersion) tuple
  # collides with an existing build (common when prior shippers — earlier fork
  # iterations, the canary, multi-dev teams — share the bundle id and burn
  # build numbers under the same marketing version). The bumped value isn't
  # visible to the lane (RELEASE_BUILD_NUMBER stays at github.run_number),
  # so an old build_number-based filter would patch the wrong build.
  #
  # Time-window filter is robust: any build with app_version=marketing_version
  # uploaded after this lane's start cannot belong to a prior shipper, only
  # to this run. expected_count caps the take to defend against a parallel
  # shipper sneaking an upload into the window.
  #
  # Pilot now blocks until ASC ingest (skip_waiting_for_build_processing
  # dropped in apple-shipkit#169), so by the time we get here, the build is
  # guaranteed-visible in Build.all. Poll loop kept defensively for short
  # ASC indexing-lag windows.
  poll_attempts = 40
  targets = []
  poll_attempts.times do |i|
    # Wrap Build.all in retry-with-backoff. ASC's /v1/builds endpoint
    # returns transient 500s under load (long-standing tracked at
    # fastlane/fastlane#21199, 33 comments and counting). Without a
    # retry, a single ASC flake fails the whole annotate step and
    # leaves the just-uploaded build with empty "What to Test" — even
    # though the binaries themselves are already live in TestFlight.
    builds = nil
    asc_attempts = 3
    asc_attempts.times do |a|
      begin
        builds = Spaceship::ConnectAPI::Build.all(
          app_id:  app.id,
          version: marketing_version,
          sort:    "-uploadedDate",
          limit:   50,
        )
        break
      rescue Spaceship::InternalServerError, Spaceship::BadGatewayError, Spaceship::GatewayTimeoutError, Spaceship::TooManyRequestsError, Spaceship::AppleTimeoutError => e
        if a == asc_attempts - 1
          UI.important("Annotate: ASC #{e.class.name.split('::').last} after #{asc_attempts} attempts (#{e.message[0, 100]}); skipping What to Test.")
          return
        end
        backoff = 5 * (2 ** a)
        UI.message("  Build.all attempt #{a + 1}/#{asc_attempts} hit #{e.class.name.split('::').last}; retrying in #{backoff}s")
        sleep backoff
      end
    end
    next unless builds

    targets = builds.select do |b|
      uploaded = (Time.parse(b.uploaded_date).utc rescue nil)
      uploaded && uploaded >= ship_start_time
    end.first(expected_count)
    break if targets.length >= expected_count
    sleep 15
    UI.message("  poll #{i + 1}/#{poll_attempts}: found #{targets.length}/#{expected_count} build(s) with version=#{marketing_version} uploaded after #{ship_start_time.iso8601}")
  end

  if targets.empty?
    UI.important("Annotate: no builds matched version=#{marketing_version} uploaded after #{ship_start_time.iso8601} after #{poll_attempts * 15}s; skipping What to Test.")
    return
  end

  targets.each do |b|
    begin
      # pilot's upload path can pre-create an empty BetaBuildLocalization
      # for en-US (the bug we're working around — it logs success but
      # never writes whatsNew). Whether ASC has indexed that empty BBL
      # by the time we get here is racy. Handle both:
      # PATCH if a BBL[en-US] already exists for this build, else POST.
      existing = b.get_beta_build_localizations.find { |x| x.locale == "en-US" }
      if existing
        Spaceship::ConnectAPI.patch_beta_build_localizations(
          localization_id: existing.id,
          attributes:      { whatsNew: changelog },
        )
        UI.message("  Annotated build #{b.version} (#{b.platform}) via PATCH (BBL #{existing.id})")
      else
        Spaceship::ConnectAPI.post_beta_build_localizations(
          build_id:   b.id,
          attributes: { locale: "en-US", whatsNew: changelog },
        )
        UI.message("  Annotated build #{b.version} (#{b.platform}) via POST")
      end
    rescue Spaceship::UnexpectedResponse => e
      UI.important("  Annotate: failed to annotate build #{b.version} (#{b.platform}): #{e.message[0, 250]}")
    end
  end

  # G10 — Export Compliance per build. `ASC_USES_NON_EXEMPT_ENCRYPTION`
  # ("true"/"false") patches the build's `usesNonExemptEncryption`
  # attribute. Apple requires this to be set on every build before
  # submission for review: the App Review queue will reject any build
  # that hasn't answered the encryption-export question. Most apps that
  # use only HTTPS qualify for the exemption — Apple's docs list HTTPS,
  # SSL/TLS, and standard library encryption as exempt — so `false` is
  # the safe default for forks that don't ship custom crypto. Set the
  # env to `true` for apps doing custom encryption (Signal-class apps,
  # E2EE messengers, etc.).
  #
  # When the env is unset, we DO NOT patch. ASC's existing value (often
  # unset on a fresh fork) stays untouched and the forker resolves it
  # via the ASC web UI before submitting for review — same workflow
  # as before this PR. Setting the env opts into one-shot automation.
  export_compliance = ENV["ASC_USES_NON_EXEMPT_ENCRYPTION"].to_s.strip.downcase
  if %w[true false].include?(export_compliance)
    targets.each do |b|
      begin
        b.update(attributes: { uses_non_exempt_encryption: export_compliance == "true" })
        UI.message("  Export compliance: build #{b.version} (#{b.platform}) → usesNonExemptEncryption=#{export_compliance}")
      rescue Spaceship::UnexpectedResponse, Spaceship::InternalServerError, Spaceship::BadGatewayError => e
        UI.important("  Export compliance: failed to patch build #{b.version} (#{b.platform}): #{e.message[0, 250]}")
      end
    end
  end

  # G13 — TestFlight Beta App information (app-wide, en-US). The four
  # `BETA_APP_*` envs map to BetaAppLocalization fields. Each is patched
  # only when its env is set non-empty; unset envs leave ASC's existing
  # values untouched (safe-additive for existing forks). PATCHes an
  # existing en-US BetaAppLocalization if present, else POSTs a new one
  # — mirrors the BBL pattern above so first-run forks work the same as
  # repeat-run forks.
  beta_app_fields = {
    description:        ENV["BETA_APP_DESCRIPTION"].to_s.strip,
    feedbackEmail:      ENV["BETA_APP_FEEDBACK_EMAIL"].to_s.strip,
    marketingUrl:       ENV["BETA_APP_MARKETING_URL"].to_s.strip,
    privacyPolicyUrl:   ENV["BETA_APP_PRIVACY_URL"].to_s.strip,
  }.reject { |_, v| v.empty? }

  unless beta_app_fields.empty?
    locale = "en-US"
    begin
      existing = app.get_beta_app_localizations.find { |x| x.locale == locale }
      if existing
        Spaceship::ConnectAPI.patch_beta_app_localizations(localization_id: existing.id, attributes: beta_app_fields)
        UI.message("  TestFlight beta app info: patched #{beta_app_fields.keys.join(', ')} via existing localization #{existing.id}")
      else
        Spaceship::ConnectAPI.post_beta_app_localizations(app_id: app.id, attributes: beta_app_fields.merge(locale: locale))
        UI.message("  TestFlight beta app info: created #{locale} localization with #{beta_app_fields.keys.join(', ')}")
      end
    rescue Spaceship::UnexpectedResponse, Spaceship::InternalServerError, Spaceship::BadGatewayError => e
      UI.important("  TestFlight beta app info: failed to update: #{e.message[0, 250]}")
    end
  end
end


# Resolve a single App Review information field. Order:
#   1. ENV[env_name] — wins if set and non-empty.
#   2. Contents of file_path — read+stripped if the file exists.
# Returns nil for any of:
#   - missing file AND unset env
#   - empty / whitespace-only value
#   - value starts with "TODO" (the tracked placeholder convention)
#   - value equals "+10000000000" (the deliberately-invalid phone sentinel
#     shipped in phone_number.txt — see comment block in do_upload_metadata)
# Callers omit nil fields from the deliver hash; deliver then errors at
# submit time with a clear "<field> is required" message instead of
# silently shipping placeholder text to App Review.
def read_review_field(env_name, file_path)
  env_val = ENV[env_name].to_s.strip
  raw = if !env_val.empty?
          env_val
        elsif File.exist?(file_path)
          read_text(file_path).strip
        end
  return nil if raw.nil? || raw.empty?
  return nil if raw.start_with?("TODO")
  return nil if raw == "+10000000000"
  raw
end

# Build deliver's `app_review_information:` hash by resolving each field via
# `read_review_field` (env → file → omit). Called from BOTH
# `do_upload_metadata` (the `make ship` annotate path) and
# `do_submit_for_review` (the `make submit` stage/submit path).
#
# Whitespace-sentinel quirk: deliver 2.233.1's `load_from_filesystem`
# (deliver/lib/deliver/upload_metadata.rb:631-634) post-merges
# `fastlane/metadata/review_information/<name>.txt` contents into the
# passed-in `app_review_information` hash using `||=`, skipping only keys
# whose existing value has `.to_s.length > 0`. So a key MISSING from the
# hash (or set to nil) gets RE-FILLED from disk — even though the caller
# explicitly wanted that field omitted. The fallback originally exists so
# forks that don't pass `app_review_information:` at all get backfilled
# from tracked files; but for omit-on-placeholder we need to defeat it.
#
# Workaround: for every "omitted" decision, store a single-space sentinel
# `" "` in the hash. `length > 0` → load_from_filesystem skips the file.
# Then deliver's `review_information()` (upload_metadata.rb:663) calls
# `strip_value = info[key].to_s.strip; attributes[k] = strip_value unless
# strip_value.empty?` — strip drops the space, the resulting value is
# empty, and the field is correctly omitted from the AppStoreReviewDetail
# PATCH. Apple receives no `contactPhone` (or whichever field), so the
# `+10000000000` placeholder never reaches their validator.
#
# Surfaced on prakashrj/my-cool-app 2026-05-11 when `make submit` shipped
# the disk-loaded `+10000000000` to Apple and got rejected with
# `An attribute value is invalid - /data/attributes/contactPhone`.
def build_review_info(review_info_dir)
  fields = {}
  [
    [:first_name,    "APP_REVIEW_FIRST_NAME",    "first_name.txt"],
    [:last_name,     "APP_REVIEW_LAST_NAME",     "last_name.txt"],
    [:email_address, "APP_REVIEW_EMAIL",         "email_address.txt"],
    [:phone_number,  "APP_REVIEW_PHONE",         "phone_number.txt"],
    [:notes,         "APP_REVIEW_NOTES",         "notes.txt"],
    [:demo_user,     "APP_REVIEW_DEMO_USER",     "demo_user.txt"],
    [:demo_password, "APP_REVIEW_DEMO_PASSWORD", "demo_password.txt"],
  ].each do |key, env_name, filename|
    val = read_review_field(env_name, File.join(review_info_dir, filename))
    # nil = omitted → " " sentinel defeats deliver's load_from_filesystem fallback
    fields[key] = val.nil? ? " " : val
  end
  fields
end

# Build the env-first ASC localized metadata hash for deliver.
#
# Resolution order for each field:
#   1. ASC_<NAME> env var (privacy_url, support_url, marketing_url, copyright,
#      primary_category, secondary_category). Set these env vars via your
#      shell profile / .envrc / CI env block when org-shared.
#   2. fastlane/metadata/<primary_locale>/<name>.txt (file fallback).
#
# Called by BOTH `do_upload_metadata` (make ship) and `do_submit_for_review`
# (make submit). Without this in the submit path, deliver's
# `load_from_filesystem` re-reads <primary_locale>/{privacy,support,marketing}_url.txt
# off disk and silently overwrites the correctly-uploaded URLs from the
# preceding `make ship`. precheck then flags `https://example.com/*` as
# HTTP 404 (advisory `warn` level — doesn't block staging, but the bogus
# URL still lands in ASC and would ship to App Review).
#
# Returns a hash safe to splat-merge into a `deliver(...)` call. Only includes
# fields with explicit env overrides OR known-good file fallbacks; disk-only
# fields (name/subtitle/description/keywords/release_notes) are left to
# deliver's own filesystem loader.
def build_asc_metadata_args(metadata_dir)
  primary_locale = ENV["ASC_PRIMARY_LOCALE"].to_s.strip
  primary_locale = "en-US" if primary_locale.empty?
  en_us_dir = File.join(metadata_dir, primary_locale)
  en_us  = ->(name) { read_text(File.join(en_us_dir, "#{name}.txt")).strip }
  locale = primary_locale
  asc_field = ->(env_name, default_block) {
    v = ENV[env_name].to_s.strip
    v.empty? ? default_block.call : v
  }
  args = {
    privacy_url:   { locale => asc_field.call("ASC_PRIVACY_URL",   -> { en_us.call("privacy_url") }) },
    support_url:   { locale => asc_field.call("ASC_SUPPORT_URL",   -> { en_us.call("support_url") }) },
    marketing_url: { locale => asc_field.call("ASC_MARKETING_URL", -> { en_us.call("marketing_url") }) },
    copyright:     asc_field.call("ASC_COPYRIGHT", -> { read_text(File.join(metadata_dir, "copyright.txt")).strip }),
  }
  args[:primary_category]   = ENV["ASC_PRIMARY_CATEGORY"].to_s.strip   unless ENV["ASC_PRIMARY_CATEGORY"].to_s.strip.empty?
  args[:secondary_category] = ENV["ASC_SECONDARY_CATEGORY"].to_s.strip unless ENV["ASC_SECONDARY_CATEGORY"].to_s.strip.empty?
  args
end

# Reads every metadata file directly and passes explicit hashes to deliver.
# Bypasses deliver's load_from_filesystem, which silently drops fields when
# metadata_path is passed alone (we've reproduced this for support_url,
# marketing_url, copyright, name, subtitle, privacy_url across multiple
# fastlane versions).
#
# `platform:` should be :ios or :osx (deliver's spelling).
def do_upload_metadata(platform:)
  metadata_dir    = File.join(__dir__, "metadata")
  # Primary App Store locale. `ASC_PRIMARY_LOCALE` env var (set via your shell
  # profile / .envrc) overrides en-US for orgs whose primary market
  # isn't English. The .txt files are expected at
  # `fastlane/metadata/<locale>/*.txt` — same path shape, different subdir
  # name. Doctor's `ScanMetadata` still scans en-US/ specifically (most
  # forks are en-US-first; non-English forks should set this env + rename
  # the metadata subdir accordingly).
  primary_locale  = ENV["ASC_PRIMARY_LOCALE"].to_s.strip
  primary_locale  = "en-US" if primary_locale.empty?
  en_us_dir       = File.join(metadata_dir, primary_locale)
  review_info_dir = File.join(metadata_dir, "review_information")

  # App Review information. Each field's resolution order:
  #   1. APP_REVIEW_* env var (recommended — keeps PII out of the tracked
  #      template tree). Set via your shell profile / .envrc / CI env block
  #      when these are stable across the team.
  #   2. fastlane/metadata/review_information/<name>.txt (file fallback).
  #
  # The template ships `TODO`-prefixed placeholders in every .txt file and
  # the deliberately-invalid sentinel `+10000000000` in phone_number.txt
  # (Apple's `contactPhone` validator rejects all-zeros). Any field whose
  # resolved value is empty, TODO-prefixed, or matches the phone sentinel
  # is omitted from the review_info hash — deliver then errors at submit
  # time with a clear "<field> is required" message instead of silently
  # shipping placeholder text to App Review.
  #
  # demo_user / demo_password are App Review's login credentials for apps
  # that gate any meaningful feature behind authentication. Apple rejects
  # such submissions without them. For no-auth apps both stay blank.
  review_info = build_review_info(review_info_dir)

  en_us  = ->(name) { read_text(File.join(en_us_dir, "#{name}.txt")).strip }
  locale = primary_locale

  # Org-stable App Store metadata (privacy/support/marketing URLs, copyright,
  # categories) — resolved env-first via the shared `build_asc_metadata_args`
  # helper. Same hash is also passed by `do_submit_for_review` so envs apply
  # to both `make ship` (metadata upload) and `make submit` (staging) paths.
  asc_metadata_args = build_asc_metadata_args(metadata_dir)

  deliver_args = asc_metadata_args.merge(
    api_key:                  asc_api_key,
    app_identifier:           APP_IDENTIFIER,
    platform:                 platform.to_s,
    metadata_path:            metadata_dir,
    app_review_information:   review_info,
    name:                     { locale => en_us.call("name") },
    subtitle:                 { locale => en_us.call("subtitle") },
    description:              { locale => en_us.call("description") },
    keywords:                 { locale => en_us.call("keywords") },
    release_notes:            { locale => en_us.call("release_notes") },
    skip_metadata:            false,
    skip_binary_upload:       true,
    skip_screenshots:         true,
    force:                    true,
    submit_for_review:        false,
    automatic_release:        false,
    precheck_include_in_app_purchases: false
  )
  deliver(**deliver_args)
  required_keys = %i[first_name last_name email_address phone_number]
  missing = required_keys.reject { |k| review_info[k] }
  if missing.empty?
    UI.success("Metadata uploaded.")
  else
    env_map = { first_name: "APP_REVIEW_FIRST_NAME", last_name: "APP_REVIEW_LAST_NAME",
                email_address: "APP_REVIEW_EMAIL", phone_number: "APP_REVIEW_PHONE" }
    pretty = missing.map { |k| env_map[k] }.join(", ")
    UI.success("Metadata uploaded. (App Review fields still pending: #{missing.join(', ')} — export #{pretty} or fill fastlane/metadata/review_information/*.txt before submit_for_review.)")
  end
end

# Read MARKETING_VERSION from app/project.yml (xcodegen) or app/Project.swift
# (tuist) — whichever is present. Mirrors Bootstrap::Version.read_marketing_version
# but inlined to avoid the cross-tree require headache (Fastfile load
# paths are unstable across runners).
def project_marketing_version(repo_root)
  yml = File.join(repo_root, "app/project.yml")
  if File.exist?(yml)
    if (m = read_text(yml).match(/^\s*MARKETING_VERSION\s*:\s*["']?([^"'\s#]+)/))
      return m[1]
    end
  end
  swift = File.join(repo_root, "app/Project.swift")
  if File.exist?(swift)
    if (m = read_text(swift).match(/"MARKETING_VERSION"\s*:\s*"([^"]+)"/))
      return m[1]
    end
  end
  nil
end

# Create a published GitHub Release for the just-submitted marketing version,
# pulling release notes from CHANGELOG.md's matching `## [<MARKETING>]` block.
#
# Pattern: per industry standard for app teams (Slack, 1Password, Notion-iOS),
# GitHub Releases mark *App Store submissions* — not every TestFlight build.
# Per-build traceability is preserved by the per-ship `vMARKETING+BUILD` git
# tags (still pushed by the `release` lane); this helper opportunistically
# upgrades the most-recent of those tags into a published Release whenever
# `submit_for_review` runs.
#
# Idempotent across iOS + macOS submissions of the same marketing version:
# the second invocation sees the existing Release and no-ops. The Release
# tag points at the latest existing `vMARKETING+*` tag (the actual build
# being submitted), not HEAD — so clicking the Release shows the exact
# commit Apple is reviewing.
#
# Skips silently when:
#   - `gh` CLI is not installed / not authenticated
#   - No `vMARKETING+*` tag exists locally (build was shipped from a different
#     machine and tags weren't fetched)
#   - The Release already exists for this marketing version
#   - `RELEASE_SKIP_GH_RELEASE=true` env override is set
#
# Skip-on-failure rather than fail-the-lane: the App Store submission has
# already succeeded by the time this runs; a Release-creation failure
# shouldn't undo it. Annotation parity with the `release` lane's whatsNew
# step (also skip-on-failure for the same reason).
def create_github_release_if_missing(repo_root:)
  if ENV["RELEASE_SKIP_GH_RELEASE"].to_s.strip.downcase == "true"
    UI.message("GH Release: RELEASE_SKIP_GH_RELEASE=true; skipping.")
    return
  end

  unless system("command -v gh >/dev/null 2>&1")
    UI.important("GH Release: `gh` CLI not found on PATH; skipping (install gh + run `gh auth login` to enable).")
    return
  end

  marketing = project_marketing_version(repo_root)
  unless marketing
    UI.important("GH Release: could not read MARKETING_VERSION from project file; skipping.")
    return
  end

  # Ensure local has the latest tags from origin (CI runs may have pushed
  # the build tag from the runner without it landing in the user's clone).
  system("git", "-C", repo_root, "fetch", "--tags", "--quiet", "origin",
         out: File::NULL, err: File::NULL)

  # Find the most-recent `<prefix>MARKETING+*` tag (the actual build being
  # submitted). Globbing a hardcoded `v` here would silently find nothing once a
  # repo sets RELEASE_TAG_PREFIX, and the GH release would just be "skipped".
  pfx = release_tag_prefix
  tag = `cd #{repo_root.shellescape} && git tag --sort=-creatordate --list '#{pfx}#{marketing}+*' 2>/dev/null`.lines.first&.strip
  if tag.nil? || tag.empty?
    # Fall back to bare `<prefix>MARKETING` if no `+BUILD` variants exist (e.g. a
    # marketing version that pre-dates the v1.7 tag scheme).
    tag = `cd #{repo_root.shellescape} && git tag --sort=-creatordate --list '#{pfx}#{marketing}' 2>/dev/null`.lines.first&.strip
  end
  if tag.nil? || tag.empty?
    UI.important("GH Release: no `#{pfx}#{marketing}*` tag found locally (run `make ship` first or fetch tags); skipping.")
    return
  end

  # Idempotency: bail if a Release already exists for this tag.
  existing = `gh release view #{tag.shellescape} --json tagName 2>/dev/null`.strip
  unless existing.empty?
    UI.success("GH Release: #{tag} already exists; nothing to do.")
    return
  end

  notes = extract_changelog_section(File.join(repo_root, "CHANGELOG.md")).to_s.strip
  notes = "Build #{tag} submitted to App Store Review." if notes.empty?

  require "tempfile"
  Tempfile.open(["release_notes", ".md"]) do |f|
    f.write(notes)
    f.close
    cmd = ["gh", "release", "create", tag,
           "--title", marketing,
           "--notes-file", f.path,
           "--latest"]
    out = `cd #{repo_root.shellescape} && #{cmd.shelljoin} 2>&1`
    if $?.success?
      UI.success("GH Release published: #{tag} → #{out.strip}")
    else
      UI.important("GH Release: `gh release create #{tag}` failed (#{out.strip[0, 200]}); skipping (App Store submission already succeeded).")
    end
  end
end

# Stage (and optionally submit) the latest TestFlight build for App Store
# review.
#
# `submit: false` — uploads metadata + screenshots + attaches the build +
#   fills export-compliance answers, but does NOT click "Submit for Review".
#   The version sits in App Store Connect's "Prepare for Submission" state.
#   Recommended for early releases — review the prepared listing in the web
#   UI, then click Submit yourself when satisfied.
#
# `submit: true` — all of the above plus clicks Submit. Version goes to
#   "Waiting for Review"; Apple's queue starts. Recommended once you trust
#   your screenshots / metadata / CHANGELOG pipeline.
#
# GH Release side-effect: only fires on the real-submit path. Staging is
# reversible; creating a "submitted" Release for a version that may never
# get submitted would be misleading.
def do_submit_for_review(platform:, submit:)
  # Build env-first hashes:
  #   - review_info (App Review contact/demo creds + notes) — without this,
  #     deliver would load review_information/*.txt directly off disk and
  #     ship the `+10000000000` phone sentinel raw. Apple rejects with
  #     `An attribute value is invalid - /data/attributes/contactPhone` at
  #     the AppStoreReviewDetail PATCH.
  #   - asc_metadata (privacy/support/marketing URLs, copyright, categories) —
  #     without this, deliver's load_from_filesystem re-reads
  #     metadata/<locale>/{privacy,support,marketing}_url.txt off disk and
  #     silently overwrites the correctly-uploaded URLs from the preceding
  #     `make ship`. precheck then flags `https://example.com/*` as HTTP 404
  #     (advisory; doesn't block staging — but the bogus URL still lands in
  #     ASC and would ship to App Review).
  # Both helpers omit / sentinel-fill any field whose resolved value is empty,
  # TODO-prefixed, or otherwise invalid; deliver's subsequent PATCH only
  # sends valid data.
  metadata_dir    = File.join(__dir__, "metadata")
  review_info_dir = File.join(metadata_dir, "review_information")
  review_info       = build_review_info(review_info_dir)
  asc_metadata_args = build_asc_metadata_args(metadata_dir)

  deliver(**asc_metadata_args.merge(
    api_key:                  asc_api_key,
    app_identifier:           APP_IDENTIFIER,
    platform:                 platform.to_s,
    skip_metadata:            false,
    skip_binary_upload:       true,
    skip_screenshots:         false,
    screenshots_path:         (platform == :osx ? './fastlane/Mac_screenshots' : './fastlane/screenshots'),
    force:                    true,
    submit_for_review:        submit,
    app_review_information:   review_info,
    automatic_release:        false,
    submission_information: {
      export_compliance_uses_encryption: false,
      export_compliance_encryption_updated: false,
      add_id_info_uses_idfa: false,
      content_rights_contains_third_party_content: false,
    },
    precheck_include_in_app_purchases: false
  ))

  if submit
    UI.success("Submitted to App Review (#{platform}).")
    repo_root = File.expand_path("..", __dir__)
    create_github_release_if_missing(repo_root: repo_root)
  else
    UI.success("Staged for review (#{platform}). Open App Store Connect to review and click Submit when ready.")
  end
end

# ─── App ID + ASC bootstrap ───────────────────────────────────────────────────

desc "Register App ID in Apple Developer Portal (idempotent)"
desc "Run once locally before the first ship. ASC app record (TestFlight side)"
desc "is verified separately via the bootstrap_asc lane."
desc "platform: ios (default) | macos, or set BUNDLE_ID_PLATFORM."
lane :register_app_id do |options|
  # An App ID carries its platform from the moment it is created, and
  # BundleIdCreateRequest requires the field — there is no "unset" to fall
  # back to. So resolve and validate it here, before authenticating, and let
  # a typo fail immediately rather than after a round trip to Apple.
  #
  # BundleIdPlatform exposes exactly IOS and MAC_OS — re-read in the locked
  # fastlane 2.238.0 on 2026-09-01 at
  # spaceship/lib/spaceship/connect_api.rb:126-130. Apple's own API
  # additionally defines UNIVERSAL, which spaceship does not surface, so a
  # single App ID covering both platforms cannot be requested from here.
  #
  # Apple can nonetheless *return* UNIVERSAL. On one team in 2026-09, all three
  # App IDs read back from GET /v1/bundleIds as UNIVERSAL — including one
  # created years earlier, and the two created minutes before by this lane with
  # IOS and MAC_OS respectively. Whether Apple ignores the requested platform at
  # create time or accepts it and normalises the record afterwards cannot be
  # told apart from a read-back, and settling it would cost a third App ID that
  # can never be reclaimed once used. So this lane reports what Apple returned
  # alongside what was asked for, and claims to know neither which of the two
  # happened nor how widely it applies.
  #
  # Registering the macOS bundle ID used to be left to match's
  # --platform macos path; match-based signing was dropped in v1.6 (#158),
  # so nothing registers a macOS App ID as a side effect any more. Passing
  # `platform:macos` is now the only way to get one.
  platform_input = (options[:platform] || ENV["BUNDLE_ID_PLATFORM"] || "ios").to_s.strip.downcase
  bundle_id_platform =
    case platform_input
    when "ios"   then Spaceship::ConnectAPI::BundleIdPlatform::IOS
    when "macos" then Spaceship::ConnectAPI::BundleIdPlatform::MAC_OS
    else
      UI.user_error!(
        "register_app_id: unknown platform #{platform_input.inspect}. " \
        "Accepted values are 'ios' and 'macos'."
      )
    end

  asc_api_key  # sets Spaceship::ConnectAPI.token globally

  bundle_id_str = APP_IDENTIFIER
  bundle_name   = APP_NAME

  existing = Spaceship::ConnectAPI::BundleId.all(filter: { identifier: bundle_id_str }).first

  if existing
    UI.success("App ID #{bundle_id_str} already registered (id=#{existing.id}, platform=#{existing.platform})")
    if existing.platform.to_s == "UNIVERSAL"
      # UNIVERSAL covers every platform, so it is not a mismatch with a request
      # for one of them, and it emphatically does not call for a second bundle
      # identifier. Saying otherwise would send a reader to burn an identifier
      # that cannot be reclaimed, over a difference that costs them nothing.
      UI.message(
        "App ID #{bundle_id_str} is reported by Apple as UNIVERSAL rather than the requested " \
        "#{bundle_id_platform}. UNIVERSAL covers every platform, so this App ID already serves " \
        "#{bundle_id_platform} — no second bundle identifier is needed."
      )
    elsif existing.platform != bundle_id_platform
      # The lookup filters on identifier alone, which is what makes re-running
      # this lane safe. It also means an existing App ID is reported as a hit
      # even when it was registered for the other platform — say so, rather
      # than letting "already registered" imply the requested platform.
      UI.important(
        "App ID #{bundle_id_str} is registered for #{existing.platform}, not the requested " \
        "#{bundle_id_platform}. An App ID's platform cannot be changed after creation; a " \
        "separate bundle ID is needed for #{bundle_id_platform}."
      )
    end
  else
    created = Spaceship::ConnectAPI::BundleId.create(
      name:       bundle_name,
      identifier: bundle_id_str,
      platform:   bundle_id_platform,
    )
    # Report Apple's answer, not the request. The previous line printed the
    # requested platform, which reads as confirmation of something nobody
    # checked — and against a team where Apple returns UNIVERSAL, it is wrong.
    UI.success(
      "App ID #{bundle_id_str} registered: id=#{created.id} " \
      "(requested #{bundle_id_platform}, Apple returned #{created.platform})"
    )
  end
end

desc "Enumerate all certificates in the team (debug helper)"
lane :list_certs do
  asc_api_key
  certs = Spaceship::ConnectAPI::Certificate.all
  UI.message("#{certs.length} certificate(s) in team:")
  certs.each do |c|
    UI.message("  #{c.id} type=#{c.certificate_type} display='#{c.display_name}' expires=#{c.expiration_date}")
  end
end

desc "Revoke a certificate by ASC certificate ID (one-time cleanup)"
desc "Usage: fastlane revoke_cert id:XN82HWM7L8"
lane :revoke_cert do |options|
  cert_id = options[:id] or UI.user_error!("id: required (ASC certificate ID)")
  asc_api_key

  cert = Spaceship::ConnectAPI::Certificate.all.find { |c| c.id == cert_id }
  UI.user_error!("Certificate #{cert_id} not found in team") unless cert

  UI.message("Revoking #{cert.id} type=#{cert.certificate_type} expires=#{cert.expiration_date}")
  Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
  UI.success("Revoked #{cert.id}")
end

desc "Revoke a batch of certificates by ASC certificate ID. Idempotent — silent on already-gone."
desc ""
desc "Pluralized companion to revoke_cert (singular). Differences:"
desc "  - takes ids:A,B,C (comma-separated) instead of id:X"
desc "  - silent on ids not found in team listing (already revoked → counts as success)"
desc "  - never raises by default; pass strict:true to fail when any id fails to revoke"
desc ""
desc "Used by the weekly local-mode canary workflow:"
desc "  pre-step  : revoke any orphan ids from a prior failed run (most weeks empty)"
desc "  post-step : revoke the 3 just-minted canary certs (always() — runs even on ship failure)"
desc ""
desc "Why idempotent-by-default: pre-step's input is from a tracking artifact and"
desc "an already-gone id is the normal case (every successful run leaves an empty"
desc "tracking file). Strict mode is for ad-hoc human use when you want loud failure."
desc ""
desc "Usage:  fastlane revoke_certs ids:ABC123,DEF456,GHI789"
desc "        fastlane revoke_certs ids:ABC123 strict:true"
lane :revoke_certs do |options|
  raw    = options[:ids].to_s
  ids    = raw.split(",").map(&:strip).reject(&:empty?)
  strict = options[:strict].to_s == "true"

  if ids.empty?
    UI.message("revoke_certs: no ids provided; nothing to do.")
    next
  end

  asc_api_key
  team_certs = Spaceship::ConnectAPI::Certificate.all
  by_id      = team_certs.each_with_object({}) { |c, h| h[c.id] = c }

  revoked = []
  missing = []
  failed  = []

  ids.each do |id|
    cert = by_id[id]
    if cert.nil?
      missing << id
      UI.message("  ! #{id} — not in team listing (already revoked); skipping")
      next
    end
    begin
      Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
      revoked << id
      UI.success("  ✓ revoked #{id} type=#{cert.certificate_type}")
    rescue StandardError => e
      failed << id
      UI.error("  ✗ #{id} — #{e.class.name}: #{e.message[0, 200]}")
    end
  end

  UI.message("revoke_certs summary: revoked=#{revoked.length} already-gone=#{missing.length} failed=#{failed.length}")

  if strict && failed.any?
    UI.user_error!("strict mode: #{failed.length} cert(s) failed to revoke — see errors above")
  end
end

desc "Mint local-mode signing identities + record their ASC ids for later revocation."
desc ""
desc "Used exclusively by the weekly local-mode canary workflow's revoke-after-run loop."
desc "Distinct from mint_local_certs in two ways:"
desc "  (1) Captures each just-minted ASC certificate id (via fastlane's CER_CERTIFICATE_ID"
desc "      env var, set by cert/runner.rb at lines 112,124,241 in fastlane 2.230)"
desc "  (2) Persists ids to out_path AFTER EACH SUCCESSFUL MINT — so partial-failure"
desc "      scenarios (e.g. mint #2 of 3 crashes) still leave a tracking file the next"
desc "      run's pre-step can clean up. Worst case: 1 orphan, 1-week stale, auto-revoked"
desc "      Monday morning."
desc ""
desc "Required env (same as mint_local_certs): ASC_API_KEY_ID, ASC_API_KEY_ISSUER_ID,"
desc "ASC_API_KEY_P8_BASE64, FASTLANE_TEAM_ID. Set by canary-local-mode.yml's env: block."
desc ""
desc "Usage: fastlane mint_canary_certs types:apple_distribution,apple_development,mac_installer_distribution out_path:/tmp/canary-orphan-ids.txt"
lane :mint_canary_certs do |options|
  raw   = options[:types].to_s
  types = raw.split(",").map(&:strip).reject(&:empty?)
  UI.user_error!("types: required (comma-separated, e.g. apple_distribution,apple_development,mac_installer_distribution)") if types.empty?

  out_path = options[:out_path] or UI.user_error!("out_path: required (path to write tracking file)")

  asc_api_key
  team     = ENV.fetch("FASTLANE_TEAM_ID")
  keychain = options[:keychain_path] || File.expand_path("~/Library/Keychains/login.keychain-db")

  # Start fresh. The workflow's pre-step has already revoked any prior orphans,
  # so we don't need to preserve old contents. An empty file means "no canary
  # certs in flight" — the post-step's always() trigger will overwrite it with
  # whatever ids we manage to mint.
  File.write(out_path, "")

  minted = []
  types.each do |type|
    UI.message("Minting #{type} for canary cycle (team #{team})…")
    type_opts = cert_options_for_type(type)
    cert(
      team_id:       team,
      api_key:       asc_api_key,
      keychain_path: keychain,
      output_path:   Dir.tmpdir,
      **type_opts
    )

    # cert action emits ENV["CER_CERTIFICATE_ID"] (intentional CER_, not CERT_;
    # cert/runner.rb:112,124,241). Reliable for both reuse-existing and
    # mint-new paths. On the canary's fresh runner keychain there are no
    # existing valid certs to reuse, so this is always the just-minted id.
    cert_id = ENV["CER_CERTIFICATE_ID"]
    if cert_id.nil? || cert_id.empty?
      UI.user_error!(
        "cert action did not set CER_CERTIFICATE_ID for #{type}. Was at " \
        "cert/runner.rb:112,124,241 in fastlane 2.230 — fastlane API may have changed."
      )
    end

    minted << { type: type, id: cert_id }
    UI.success("  → #{type} minted as #{cert_id}")

    # Persist after EACH mint, not at end. If the next type's mint kills the
    # process (Apple 5xx, network blip, etc.), the tracking file already
    # contains every id minted so far.
    File.write(out_path, minted.map { |m| m[:id] }.join("\n") + "\n")
  end

  UI.success("Minted #{minted.length} cert(s); ids persisted to #{out_path}")
  UI.message("Tracking contents:")
  minted.each { |m| UI.message("  #{m[:type]} → #{m[:id]}") }
end

desc "Audit local login.keychain for Apple cert types and delete revoked-at-Apple ones."
desc ""
desc "Diffs certs in your login.keychain against Apple's valid-cert list (queried via"
desc "ASC API) and deletes the locally-cached ones whose serials Apple no longer"
desc "lists as valid."
desc ""
desc "Why this exists: xcodebuild's CODE_SIGN_IDENTITY=Apple Distribution does"
desc "substring matching against the keychain. Multiple matches → undefined which"
desc "one xcodebuild picks. If any matching cert is revoked at Apple, the build"
desc "fails with 'Signing certificate is invalid'. `security find-identity -v`"
desc "doesn't filter revoked-at-Apple certs (only locally-expired ones)."
desc ""
desc "Usage:"
desc "  bundle exec fastlane clean_revoked_certs               # interactive prompt"
desc "  bundle exec fastlane clean_revoked_certs yes:true      # delete without prompt"
desc "  bundle exec fastlane clean_revoked_certs dry_run:true  # show diff but don't delete"
lane :clean_revoked_certs do |options|
  require "openssl"
  require "set"

  yes_flag = options[:yes].to_s == "true"
  dry_run  = options[:dry_run].to_s == "true"

  asc_api_key

  # Subject-string prefix on the local cert → Apple-side type names that
  # this prefix can correspond to. We diff against the union of all
  # matching types' serials so a cert labeled e.g. "Apple Distribution"
  # locally matches Apple's APPLE_DISTRIBUTION as well as the legacy
  # DISTRIBUTION/IOS_DISTRIBUTION/MAC_APP_DISTRIBUTION.
  audit_types = {
    "Apple Distribution"                => %w[APPLE_DISTRIBUTION DISTRIBUTION IOS_DISTRIBUTION MAC_APP_DISTRIBUTION],
    "Apple Development"                 => %w[APPLE_DEVELOPMENT DEVELOPMENT IOS_DEVELOPMENT MAC_APP_DEVELOPMENT],
    "3rd Party Mac Developer Installer" => %w[MAC_INSTALLER_DISTRIBUTION]
  }

  # Normalize hex serial: uppercase + strip leading zeros. Apple's API and
  # OpenSSL's cert.serial both render hex serials slightly differently
  # (case + leading-zero treatment); normalization makes set-equality work.
  normalize = ->(s) { s.to_s.upcase.gsub(/\A0+/, "") }

  UI.header("Querying Apple Developer Portal for valid certificates")
  apple_certs = Spaceship::ConnectAPI::Certificate.all
  UI.message("  total certificates Apple lists for this team: #{apple_certs.length}")
  apple_certs.group_by(&:certificate_type).each do |type, certs|
    UI.message("    #{type}: #{certs.length} (#{certs.map(&:id).join(', ')})")
  end
  apple_valid_serials = apple_certs.map { |c| normalize.call(c.serial_number) }.compact.to_set

  UI.header("Scanning local login.keychain for relevant cert types")
  login_keychain = File.expand_path("~/Library/Keychains/login.keychain-db")
  pem_blob = `security find-certificate -a -p "#{login_keychain}" 2>/dev/null`
  pems = pem_blob.scan(/-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----/m)

  candidates = []
  pems.each do |pem|
    begin
      cert = OpenSSL::X509::Certificate.new(pem)
      subject = cert.subject.to_s
      audit_type = audit_types.keys.find { |t| subject.include?(t) }
      next unless audit_type
      candidates << {
        audit_type: audit_type,
        sha1:       OpenSSL::Digest::SHA1.hexdigest(cert.to_der).upcase,
        serial:     normalize.call(cert.serial.to_s(16)),
        subject:    subject,
        not_after:  cert.not_after
      }
    rescue OpenSSL::X509::CertificateError
      # Non-X.509 entries (some keychain blobs aren't certs) — skip silently.
    end
  end

  if candidates.empty?
    UI.success("No Apple-issued signing certs found in login.keychain. Nothing to audit.")
    next
  end
  UI.message("  found #{candidates.length} local cert(s) of audited types")

  revoked = candidates.reject { |c| apple_valid_serials.include?(c[:serial]) }
  kept = candidates.length - revoked.length

  UI.header("Audit summary")
  UI.message("  kept (Apple-valid):  #{kept}")
  UI.message("  revoked (locally):   #{revoked.length}")

  if revoked.empty?
    UI.success("All local Apple-signing certs are valid at Apple. Keychain is clean.")
    next
  end

  UI.header("Locally-cached certs Apple no longer lists as valid")
  revoked.each_with_index do |cert, i|
    UI.message("  #{i + 1}. #{cert[:audit_type]}")
    UI.message("     subject:   #{cert[:subject]}")
    UI.message("     SHA-1:     #{cert[:sha1]}")
    UI.message("     serial:    #{cert[:serial]}")
    UI.message("     not after: #{cert[:not_after]}")
  end

  if dry_run
    UI.success("[dry-run] would delete #{revoked.length} cert(s). Re-run without dry_run:true to actually delete.")
    next
  end

  proceed = yes_flag || UI.confirm("Delete these #{revoked.length} cert(s) from login.keychain?")
  next unless proceed

  UI.header("Deleting revoked certs")
  failed = 0
  revoked.each_with_index do |cert, i|
    UI.message("  #{i + 1}. deleting #{cert[:sha1]}...")
    if Kernel.system("security", "delete-certificate", "-Z", cert[:sha1], login_keychain)
      UI.success("     ✓ deleted")
    else
      UI.error("     ✗ delete failed (try manually: security delete-certificate -Z #{cert[:sha1]} ~/Library/Keychains/login.keychain-db)")
      failed += 1
    end
  end

  if failed.zero?
    UI.success("Done. #{revoked.length} cert(s) deleted from login.keychain.")
  else
    UI.user_error!("#{failed}/#{revoked.length} delete(s) failed; see warnings above.")
  end
end

desc "Revoke signing certs on Apple's side (distribution + development) that have"
desc "in your login.keychain. Inverse direction of clean_revoked_certs:"
desc ""
desc "  clean_revoked_certs  : Apple's list is truth → delete stale LOCAL certs"
desc "  revoke_orphan_certs  : your local Keychain is truth → revoke orphan APPLE certs"
desc ""
desc "Why this exists: Apple caps both Distribution (3 per team) and Development"
desc "(~2 per registered device) signing certs. Each CI release run mints a fresh"
desc "set and revokes them in an if: always() post-step, but the post-step can be"
desc "skipped (runner evicted, hard crash, cache-evicted tracking"
desc "file). Over time, the team accumulates Apple-side cert IDs whose private keys"
desc "live nowhere — neither on the user's Mac nor on any CI runner. The next"
desc "release run then hits 'Could not create another Distribution certificate,"
desc "reached the maximum number of available Distribution certificates' at the"
desc "minting step. Previously the only recovery was the developer.apple.com web UI"
desc "(~30 sec but error-prone — easy to revoke a cert that IS in use elsewhere)."
desc ""
desc "Safety guard: only certs whose SHA-1 / serial is NOT present in"
desc "~/Library/Keychains/login.keychain-db are flagged. If your Mac has the cert,"
desc "you can use it for signing somewhere — so it's not an orphan. (Single-user"
desc "teams: this is sufficient. Multi-user teams: ensure every developer's Mac"
desc "has the keys it needs locally before running this — coordinate first.)"
desc ""
desc "Usage:"
desc "  bundle exec fastlane revoke_orphan_certs              # interactive prompt"
desc "  bundle exec fastlane revoke_orphan_certs yes:true     # revoke without prompt"
desc "  bundle exec fastlane revoke_orphan_certs dry_run:true # list orphans, don't revoke"
lane :revoke_orphan_certs do |options|
  require "openssl"
  require "set"

  yes_flag = options[:yes].to_s == "true"
  dry_run  = options[:dry_run].to_s == "true"

  asc_api_key

  # Subject-string prefixes that map to signing certs. We audit BOTH Distribution
  # and Development cert types because Apple caps each independently (3 per team
  # for Distribution; ~2 per registered device for Development — both surface as
  # "Could not create another ... certificate, reached the maximum number of
  # available ... certificates" in `cert` action output). The lane's safety
  # guard is identical for both: if your Mac has the private key, you can sign
  # with it somewhere → not an orphan → left alone.
  audited_subject_prefixes = [
    # Distribution-class
    "Apple Distribution", "iPhone Distribution", "Mac App Distribution", "3rd Party Mac Developer Installer",
    # Development-class
    "Apple Development", "iPhone Developer", "Mac Developer",
  ]
  audited_apple_types = %w[
    APPLE_DISTRIBUTION DISTRIBUTION IOS_DISTRIBUTION MAC_APP_DISTRIBUTION MAC_INSTALLER_DISTRIBUTION
    APPLE_DEVELOPMENT DEVELOPMENT IOS_DEVELOPMENT MAC_APP_DEVELOPMENT
  ].to_set

  # Normalize hex serial: uppercase + strip leading zeros (Apple's API renders
  # differently from OpenSSL; normalization makes set-equality work). Mirrors
  # the normalize used in clean_revoked_certs.
  normalize = ->(s) { s.to_s.upcase.gsub(/\A0+/, "") }

  UI.header("Scanning local login.keychain for signing-cert serials")
  login_keychain = File.expand_path("~/Library/Keychains/login.keychain-db")
  pem_blob = `security find-certificate -a -p "#{login_keychain}" 2>/dev/null`
  pems = pem_blob.scan(/-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----/m)

  local_serials = Set.new
  pems.each do |pem|
    begin
      cert = OpenSSL::X509::Certificate.new(pem)
      subject = cert.subject.to_s
      next unless audited_subject_prefixes.any? { |p| subject.include?(p) }
      local_serials << normalize.call(cert.serial.to_s(16))
    rescue OpenSSL::X509::CertificateError
      # Non-X.509 entries in the keychain blob — skip silently.
    end
  end
  UI.message("  found #{local_serials.length} signing cert(s) locally (dist + dev)")

  UI.header("Querying Apple Developer Portal for distribution + development certificates")
  apple_certs = Spaceship::ConnectAPI::Certificate.all
  audited_apple_certs = apple_certs.select { |c| audited_apple_types.include?(c.certificate_type) }
  UI.message("  Apple lists #{audited_apple_certs.length} signing cert(s) for this team")
  audited_apple_certs.group_by(&:certificate_type).each do |type, certs|
    UI.message("    #{type}: #{certs.length} (#{certs.map(&:id).join(', ')})")
  end

  orphans = audited_apple_certs.reject { |c| local_serials.include?(normalize.call(c.serial_number)) }
  in_use  = audited_apple_certs.length - orphans.length

  UI.header("Audit summary")
  UI.message("  in-use (matching local private key):  #{in_use}")
  UI.message("  orphan (no local match):              #{orphans.length}")

  if orphans.empty?
    UI.success("All Apple-side signing certs (distribution + development) have matching local private keys. Nothing to revoke.")
    next
  end

  UI.header("Orphan signing certs Apple lists but no local private key exists for")
  orphans.each_with_index do |cert, i|
    UI.message("  #{i + 1}. #{cert.id}")
    UI.message("     type:        #{cert.certificate_type}")
    UI.message("     display:     #{cert.display_name}")
    UI.message("     expires:     #{cert.expiration_date}")
    UI.message("     serial:      #{normalize.call(cert.serial_number)}")
  end

  if dry_run
    UI.success("[dry-run] would revoke #{orphans.length} cert(s). Re-run without dry_run:true to actually revoke.")
    next
  end

  proceed = yes_flag || UI.confirm("Revoke these #{orphans.length} orphan cert(s) at Apple?")
  next unless proceed

  UI.header("Revoking orphan certs")
  revoked = []
  failed  = []
  orphans.each_with_index do |cert, i|
    UI.message("  #{i + 1}. revoking #{cert.id} (#{cert.certificate_type})...")
    begin
      Spaceship::ConnectAPI.delete_certificate(certificate_id: cert.id)
      revoked << cert.id
      UI.success("     ✓ revoked")
    rescue StandardError => e
      failed << cert.id
      UI.error("     ✗ #{e.class.name}: #{e.message[0, 200]}")
    end
  end

  UI.message("revoke_orphan_certs summary: revoked=#{revoked.length} failed=#{failed.length}")

  if failed.any?
    UI.user_error!("#{failed.length}/#{orphans.length} revoke(s) failed; see errors above.")
  end
  UI.success("Done. #{revoked.length} orphan cert(s) revoked. `make ship` should now succeed.")
end

desc "Mint missing local-mode signing identities into the user's login keychain."
desc ""
desc "Idempotent: fastlane cert detects existing valid certs in the keychain and"
desc "reuses rather than minting duplicates, so re-running on a partially-set-up"
desc "machine is safe."
desc ""
desc "Required env (set automatically by Bootstrap.asc_env when called via"
desc "`make mint-local-certs` or `make bootstrap-fork`):"
desc "  ASC_API_KEY_ID, ASC_API_KEY_ISSUER_ID, ASC_API_KEY_P8_BASE64, FASTLANE_TEAM_ID"
desc ""
desc "Usage: fastlane mint_local_certs types:apple_distribution,apple_development,mac_installer_distribution"
lane :mint_local_certs do |options|
  raw = options[:types].to_s
  types = raw.split(",").map(&:strip).reject(&:empty?)
  UI.user_error!("types: required (comma-separated, e.g. apple_distribution,mac_installer_distribution)") if types.empty?

  api_key = asc_api_key
  team    = ENV.fetch("FASTLANE_TEAM_ID")
  keychain = File.expand_path("~/Library/Keychains/login.keychain-db")

  types.each do |type|
    UI.message("Minting #{type} for team #{team} (idempotent — fastlane cert reuses existing valid certs)...")
    type_opts = cert_options_for_type(type)
    cert(
      team_id:       team,
      api_key:       api_key,
      keychain_path: keychain,
      # output_path lands the .cer + .p12 in /tmp; cert action also imports
      # both into the keychain in one shot. We don't need the artifacts
      # afterward (login keychain is the source of truth).
      output_path:   Dir.tmpdir,
      **type_opts
    )
  end

  UI.success("Local-mode signing identities ready in login keychain.")
end

desc "Idempotently verify Dev Portal App ID + ASC App record exist."
desc ""
desc "Calls register_app_id (creates the Dev Portal App ID via Spaceship if"
desc "missing), then verifies the App Store Connect App record exists. The"
desc "ASC App record CANNOT be created via API key — Apple's public ASC API"
desc "exposes only GET/UPDATE on /apps, never POST. fastlane's `produce`"
desc "action falls back to Apple-ID + 2FA login for app creation, which we"
desc "deliberately don't carry in CI secrets. So this lane verifies and"
desc "fails fast with instructions if the App is missing — a one-time"
desc "human step against appstoreconnect.apple.com unblocks all future"
desc "automated runs."
lane :bootstrap_asc do
  # 1. Ensure App ID exists in Apple Developer Portal (idempotent; uses
  #    Spaceship::ConnectAPI::BundleId which DOES allow POST).
  register_app_id

  # 2. Verify ASC App record exists (TestFlight / App Store side).
  bundle_id_str = APP_IDENTIFIER
  existing = Spaceship::ConnectAPI::App.find(bundle_id_str)

  if existing
    UI.success("ASC app for #{bundle_id_str} exists (id=#{existing.id}).")
  else
    # `return` inside a fastlane lane block is a LocalJumpError. UI.user_error!
    # raises FastlaneError, which fastlane catches and prints — same end result
    # as a hard failure but compatible with the lane DSL.
    UI.user_error!(<<~MSG)
      ASC App record for #{bundle_id_str} not found.

      The App Store Connect API does not allow POST /apps. Create the App
      once via the web UI:

        1. https://appstoreconnect.apple.com/apps  →  + (New App)
        2. Platforms: iOS + macOS
           Name:      HelloApp  (or whatever; verify uses bundle_id, not name)
           Primary language: English (U.S.)
           Bundle ID: #{bundle_id_str}
           SKU:       any-unique-string
           User Access: Full Access
        3. Re-run this lane — it will succeed and never block again.

      Apple ref: https://developer.apple.com/documentation/appstoreconnectapi/apps
      fastlane workaround (produce) requires Apple ID + 2FA, which we
      deliberately don't carry in CI. One-time human step is the cleanest path.
    MSG
  end
end

# ─── Adopt an existing live App Store app ────────────────────────────────────
#
# Pulls existing metadata + screenshots from a live ASC App record into the
# local `fastlane/` tree. Use this on forks adopting an app that's already in
# the App Store BEFORE running `make submit`, which would otherwise upload
# the template's placeholder metadata and CLOBBER your live App Store listing.
#
# Idempotent — re-running re-syncs from ASC. Existing local files overwritten.
#
# Wraps two fastlane CLI subcommands (`fastlane deliver download_metadata` and
# `fastlane deliver download_screenshots`) via `sh` because they're not exposed
# as Ruby actions callable from inside a lane. Builds a temporary api_key JSON
# file from the template's ENV-triple (ASC_API_KEY_ID / ASC_API_KEY_ISSUER_ID /
# ASC_API_KEY_P8_BASE64) since `deliver` accepts `--api_key_path PATH_TO_JSON`
# but not the env triple directly.
desc "Pull existing metadata + screenshots from a live App Store Connect app."
desc ""
desc "Use on forks adopting a LIVE App Store app, BEFORE `make submit` (which"
desc "would otherwise upload local placeholders and clobber the live listing)."
desc ""
desc "Driven by `make adopt` (which pre-validates BUNDLE_ID + git-clean state)."
desc ""
desc "Options (CLI-passable or env-set):"
desc "  skip_metadata:true        skip metadata download (faster — screenshots only)"
desc "  skip_screenshots:true     skip screenshot download (faster — metadata only)"
lane :adopt_existing_app do |options|
  app_identifier = APP_IDENTIFIER

  # Hard-stop on the template placeholder — adoption only makes sense for forks
  # pointing at a REAL bundle id with a real ASC App record. A user running
  # `make adopt` without setting BUNDLE_ID would otherwise hit an opaque
  # "App not found" from Spaceship.
  if app_identifier == "com.example.helloapp"
    UI.user_error!(
      "adopt_existing_app: BUNDLE_ID is the template placeholder " \
      "'com.example.helloapp'. Set your real bundle id in .bootstrap.env " \
      "first. If this is a greenfield fork (new app, no existing App Store " \
      "presence), don't run adopt — just edit fastlane/metadata/en-US/*.txt " \
      "directly with your App Store copy."
    )
  end

  asc_api_key  # primes @asc_p8_path on the singleton (before_all also calls it)

  # Build the api_key JSON file deliver's CLI expects. Format documented at
  # https://docs.fastlane.tools/app-store-connect-api/#using-fastlane-api-key-json-file.
  # tmpfile cleaned up on process exit (at_exit hook).
  require "json"
  require "tmpdir"
  api_key_json_path = File.join(
    Dir.tmpdir,
    "asc_api_key_#{ENV.fetch('ASC_API_KEY_ID')}.json"
  )
  File.write(api_key_json_path, JSON.dump(
    "key_id"    => ENV.fetch("ASC_API_KEY_ID"),
    "issuer_id" => ENV.fetch("ASC_API_KEY_ISSUER_ID"),
    "key"       => read_key_material(@asc_p8_path),
    "duration"  => 1200,
    "in_house"  => false,
  ))
  File.chmod(0600, api_key_json_path)
  at_exit do
    File.unlink(api_key_json_path) if File.exist?(api_key_json_path)
  rescue StandardError
    # Best-effort cleanup; don't blow up the exit path.
  end

  repo_root        = File.expand_path("..", __dir__)
  metadata_path    = File.join(repo_root, "fastlane", "metadata")
  screenshots_path = File.join(repo_root, "fastlane", "screenshots")

  # Verify the app exists on ASC before downloading anything. Spaceship's
  # `App.find` returns nil on miss; we surface that with actionable next steps
  # instead of letting `deliver download_metadata` fail later with a less
  # informative error.
  require "spaceship"
  Spaceship::ConnectAPI.token ||= Spaceship::ConnectAPI::Token.create(
    key_id:    ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_KEY_ISSUER_ID"),
    key:       read_key_material(@asc_p8_path),
  )

  app = Spaceship::ConnectAPI::App.find(app_identifier)
  unless app
    UI.user_error!(
      "adopt_existing_app: no ASC App record found for bundle " \
      "'#{app_identifier}' on team #{ENV['FASTLANE_TEAM_ID']}.\n" \
      "Verify:\n" \
      "  1. BUNDLE_ID in .bootstrap.env is your real app's bundle id\n" \
      "  2. FASTLANE_TEAM_ID in .bootstrap.env owns the app\n" \
      "  3. ASC_API_KEY_* credentials have ASC access for this team\n" \
      "If your fork is greenfield (no existing App Store app), don't run " \
      "adopt — `make doctor` + `make all` is the greenfield path."
    )
  end

  UI.header("Adopting: #{app.name} (#{app_identifier})")

  # Resolve skip flags from both options-hash (CLI: skip_metadata:true) and env
  # (Makefile target users typically pass via `make adopt SKIP_METADATA=true`).
  skip_metadata    = options[:skip_metadata].to_s == "true"    || ENV["SKIP_METADATA"]    == "true"
  skip_screenshots = options[:skip_screenshots].to_s == "true" || ENV["SKIP_SCREENSHOTS"] == "true"

  if skip_metadata
    UI.message("Skipping metadata download (SKIP_METADATA=true)")
  else
    UI.header("Pulling metadata → fastlane/metadata/")
    # Snapshot existing files' mtimes so we can detect whether `deliver
    # download_metadata` actually wrote anything. Required because deliver
    # has a silent-no-op failure mode (see below) where it returns exit 0
    # without writing any files — and our subsequent UI.success would lie.
    pre_meta_mtimes = Dir.glob(File.join(metadata_path, "**", "*.txt")).each_with_object({}) do |f, h|
      h[f] = File.mtime(f)
    end
    # `--force` is REQUIRED. fastlane 2.233.x's `deliver download_metadata`
    # gates the download behind `force_overwrite_metadata?` which:
    #   - returns true if --force is passed (or DELIVER_FORCE_OVERWRITE=true env)
    #   - prompts y/n if UI.interactive? (TTY attached)
    #   - returns nil otherwise → command immediately `return 0` without writing
    # We're invoked via `sh "bundle exec ..."` from inside another fastlane
    # lane → no TTY → no --force ⇒ silent no-op. The deliver subcommand log
    # output looks identical to a real download (summary table prints, exit 0
    # returned), but zero files are touched. Caller-visible: every existing-app
    # fork's `make adopt` returned success while pulling nothing. Belt-and-
    # suspenders: also export DELIVER_FORCE_OVERWRITE=true via the sh env.
    sh(
      { "DELIVER_FORCE_OVERWRITE" => "true" },
      "bundle exec fastlane deliver download_metadata " \
      "--force " \
      "--api_key_path #{api_key_json_path.shellescape} " \
      "--app_identifier #{app_identifier.shellescape} " \
      "--metadata_path #{metadata_path.shellescape}"
    )
    # Verify deliver actually wrote files. Counts files whose mtime advanced
    # relative to the pre-snapshot, plus brand-new files that didn't exist
    # before. If zero, the silent-no-op bug fired anyway (e.g. fastlane was
    # upgraded to a version that re-broke this), and we MUST surface it
    # rather than ship a false-success message that the user trusts and
    # commits over real ASC state.
    post_meta_files = Dir.glob(File.join(metadata_path, "**", "*.txt"))
    rewritten = post_meta_files.count { |f| pre_meta_mtimes[f].nil? || File.mtime(f) > pre_meta_mtimes[f] }
    if rewritten.zero?
      UI.user_error!(
        "deliver download_metadata returned success but wrote 0 files to " \
        "#{metadata_path}.\n\n" \
        "This is the fastlane silent-no-op bug: `force_overwrite_metadata?` " \
        "returned false in non-interactive mode, so download_metadata exited " \
        "0 without doing any work. Our lane already passes --force; if you're " \
        "seeing this, fastlane's gate logic likely changed in a newer " \
        "version. File an issue at indiagrams/apple-shipkit. Workaround: try " \
        "`bundle update fastlane` and re-run `make adopt`."
      )
    end
    UI.success("Metadata downloaded to #{metadata_path} (#{rewritten} of #{post_meta_files.size} files updated)")
  end

  if skip_screenshots
    UI.message("Skipping screenshot download (SKIP_SCREENSHOTS=true)")
  else
    UI.header("Pulling screenshots → fastlane/screenshots/")
    # Pre-count screenshots so the success line can report what changed.
    # download_screenshots does NOT have the silent-no-op gate that metadata
    # does (no force_overwrite_screenshots? wrapper), but we mirror the
    # post-snapshot for parity and to surface "downloaded 0 screenshots"
    # cases — common for fresh ASC App records with PREPARE_FOR_SUBMISSION
    # versions where the user hasn't uploaded screenshots yet.
    pre_shot_files = Dir.glob(File.join(screenshots_path, "**", "*.{png,jpg,jpeg}"))
    sh(
      "bundle exec fastlane deliver download_screenshots " \
      "--api_key_path #{api_key_json_path.shellescape} " \
      "--app_identifier #{app_identifier.shellescape} " \
      "--screenshots_path #{screenshots_path.shellescape}"
    )
    post_shot_files = Dir.glob(File.join(screenshots_path, "**", "*.{png,jpg,jpeg}"))
    delta = post_shot_files.size - pre_shot_files.size
    UI.success("Screenshots downloaded to #{screenshots_path} (#{post_shot_files.size} files total#{delta != 0 ? ", #{delta > 0 ? '+' : ''}#{delta} change" : ''})")
  end

  # Report current ASC marketing version so the user knows what to set their
  # local app/project.yml or app/Project.swift to. We deliberately do NOT
  # auto-edit those files — the user might be doing a deliberate version
  # bump simultaneously, or their version string might be a custom format
  # (3.4.2-rc1 etc.) the template's auto-substitution would mangle.
  begin
    # Use the instance method on the already-resolved App object. The
    # `Spaceship::ConnectAPI::AppStoreVersion.all(app_id: …)` class-method
    # form doesn't exist in spaceship 2.233.x; tracked at fastlane/fastlane
    # in passing across multiple issue threads (no clean canonical reference).
    # `get_app_store_versions` returns up to 10 most-recent versions across
    # all states (live, ready-for-sale, prepare-for-submission, in-review,
    # etc.); take the first 5 to mirror the prior limit semantics.
    versions = app.get_app_store_versions
    versions = versions.first(5) if versions.is_a?(Array)
    if versions && !versions.empty?
      latest = versions.first
      UI.header("Marketing version sync")
      UI.message("  Latest ASC version: #{latest.version_string} (state: #{latest.app_store_state})")
      UI.message("  Update MARKETING_VERSION in app/project.yml (or app/Project.swift)")
      UI.message("  to #{latest.version_string} or higher before `make ship`.")
      UI.message("  apple-shipkit's CFBundleVersion auto-bump handles build-number side.")
    end
  rescue StandardError => e
    UI.important("Couldn't fetch ASC version info (non-fatal): #{e.message[0, 200]}")
  end

  UI.success("\nAdoption complete. Next steps:")
  UI.message("  1. Review: git diff fastlane/metadata fastlane/screenshots")
  UI.message("  2. Commit: git add fastlane/ && git commit -m 'chore: adopt existing ASC app state'")
  UI.message("  3. Sync MARKETING_VERSION in app/project.yml (or app/Project.swift) if needed")
  UI.message("  4. `make ship` joins existing build history; `make submit` ships YOUR metadata")
end


# ─── iOS lanes ────────────────────────────────────────────────────────────────
platform :ios do
  desc "Sign + upload to TestFlight + push tag"
  desc "Usage:    fastlane release tag:v0.1.0"
  desc "Dry run:  fastlane release tag:v0.1.0 skip_upload:true skip_tag:true"
  lane :release do |options|
    tag         = options[:tag] or UI.user_error!("tag: option is required (e.g. tag:v0.1.0)")
    skip_upload    = options[:skip_upload]    || false
    skip_tag       = options[:skip_tag]       || false
    skip_changelog = options[:skip_changelog] || false
    changelog_arg  = options[:changelog]

    repo_root = File.expand_path("..", __dir__)
    version   = strip_release_tag_prefix(tag)
    dry_run   = skip_upload || skip_tag

    # PLATFORMS gates which targets get built/signed/uploaded.
    # Set via .bootstrap.env's PLATFORMS field (defaults to 'ios,macos').
    # Threaded into this lane via release.yml's `PLATFORMS` env var (CI mode)
    # or bin/ship.rb's local-mode env (local mode). Empty/unset → both.
    raw_platforms = (ENV["PLATFORMS"].to_s.strip.empty? ? "ios,macos" : ENV["PLATFORMS"])
    active_platforms = raw_platforms.split(",").map(&:strip).reject(&:empty?)
    do_ios   = active_platforms.include?("ios")
    do_macos = active_platforms.include?("macos")
    UI.user_error!("PLATFORMS must include at least one of 'ios' or 'macos' (got #{raw_platforms.inspect})") unless do_ios || do_macos

    UI.header("Release #{tag}#{dry_run ? " [DRY RUN]" : ""} — platforms: #{active_platforms.join('+')}")

    # Cert sourcing: sigh fetches the App Store profile via ASC API. Signing
    # certs come from whichever keychain is the default at this point — the
    # user's login keychain (local mode, certs auto-minted by `make
    # bootstrap-fork` / `make mint-local-certs`) or the runner's controlled
    # release keychain (CI mode, certs minted by release.yml's
    # mint_canary_certs step before this lane runs). Either way, the lane
    # itself doesn't care WHICH keychain — it just calls sigh + xcodebuild
    # and lets the OS resolve identities by SHA-1 pinning.
    #
    # We dropped match-based CI signing in v1.6 (apple-shipkit#158) — match
    # required a separate certs repo, MATCH_PASSWORD/MATCH_GIT_BASIC_AUTHORIZATION
    # secrets, and broke for legacy WWDR-G3-issued certs on macos-15-arm64.
    # The mint-fresh-per-run approach (used by canary-local-mode.yml since
    # v1.5) is simpler, more robust, and works for both modes.
    #
    # sigh emits sigh_<bundle>_appstore_profile-name env vars (legacy-named
    # but still authoritative — sigh used to be `match`'s profile mintng
    # backend), which local-release-check.sh's manual-signing path reads to
    # switch xcodebuild from automatic to manual signing. This avoids the
    # cloud-signing endpoint entirely.
    sh_env = { "RELEASE_BUNDLE_ID" => APP_IDENTIFIER }

    # Capture lane start time for the time-window filter in Step 5/6's
    # annotate step. Any TestFlight build with this app's marketing_version
    # uploaded after this timestamp is by definition our build, regardless
    # of what CFBundleVersion the binary ended up with after ASC's potential
    # auto-bump.
    ship_start_time = Time.now.utc

    bits = []
    bits << "iOS"   if do_ios
    bits << "macOS" if do_macos
    UI.message("Step 1/5: minting App Store profile(s) via sigh (#{bits.join(' + ')}).")


    # sigh does NOT emit `sigh_<bundle>_<type>_profile-name` env vars
    # the way match does — those are match-specific. sigh's per-call
    # output lands in lane_context[SharedValues::SIGH_NAME], which gets
    # overwritten on the next sigh call. Capture between iOS and macOS
    # calls so multi-platform forks get both names.
    #
    # output_path: Dir.tmpdir keeps the .mobileprovision artifact out
    # of the repo working tree (sigh's default output_path is cwd,
    # which would scatter `AppStore_<bundle>.mobileprovision` files at
    # the repo root and risk accidental commits). The profile is also
    # auto-installed into ~/Library/MobileDevice/Provisioning Profiles/
    # (sigh default skip_install=false), which is what xcodebuild
    # actually reads at archive/export time.
    #
    # Helper: extract the SHA-1 hash of the profile's bound signing cert
    # (the first entry in DeveloperCertificates). We pin xcodebuild to
    # this exact cert via CODE_SIGN_IDENTITY=<sha1> in local-release-
    # check.sh — without it, xcodebuild substring-matches "Apple
    # Distribution" against the keychain, which is ambiguous when
    # multiple Apple-valid certs of that name exist (cert rotation, multi-
    # team users, etc.). The profile binds to ONE cert; we honor it.
    cert_sha1_from_profile = ->(profile_path) {
      decoded = `security cms -D -i "#{profile_path}" 2>/dev/null`
      return nil if decoded.empty?
      cert_b64 = nil
      require "tempfile"
      Tempfile.open(["profile", ".plist"]) do |f|
        f.write(decoded)
        f.close
        cert_b64 = `plutil -extract DeveloperCertificates.0 raw -o - "#{f.path}" 2>/dev/null`.strip
      end
      return nil if cert_b64.empty?
      require "base64"
      require "digest"
      der = Base64.decode64(cert_b64)
      Digest::SHA1.hexdigest(der).upcase
    }

    if do_ios
      sigh(
        app_identifier: APP_IDENTIFIER,
        team_id:        ENV.fetch("FASTLANE_TEAM_ID"),
        api_key:        asc_api_key,
        platform:       "ios",
        readonly:       false,
        output_path:    Dir.tmpdir
      )
      ios_profile_name = lane_context[SharedValues::SIGH_NAME]
      ios_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
      UI.user_error!("sigh didn't set SIGH_NAME after iOS mint — fastlane API may have changed") unless ios_profile_name
      sh_env["RELEASE_IOS_PROFILE_NAME"] = ios_profile_name
      sh_env["RELEASE_IOS_CERT_SHA1"] = cert_sha1_from_profile.call(ios_profile_path) || ""
      UI.message("  iOS profile binds to cert SHA-1: #{sh_env['RELEASE_IOS_CERT_SHA1']}")
    end
    if do_macos
      sigh(
        app_identifier: APP_IDENTIFIER,
        team_id:        ENV.fetch("FASTLANE_TEAM_ID"),
        api_key:        asc_api_key,
        platform:       "macos",
        readonly:       false,
        output_path:    Dir.tmpdir
      )
      macos_profile_name = lane_context[SharedValues::SIGH_NAME]
      macos_profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
      UI.user_error!("sigh didn't set SIGH_NAME after macOS mint — fastlane API may have changed") unless macos_profile_name
      sh_env["RELEASE_MACOS_PROFILE_NAME"] = macos_profile_name
      sh_env["RELEASE_MACOS_CERT_SHA1"] = cert_sha1_from_profile.call(macos_profile_path) || ""
      UI.message("  macOS profile binds to cert SHA-1: #{sh_env['RELEASE_MACOS_CERT_SHA1']}")
    end

    sign_flags = []
    sign_flags << "--sign-ios"   if do_ios
    sign_flags << "--sign-macos" if do_macos
    UI.message("Step 2/5: building signed artifacts (#{sign_flags.join(' ')}) for v#{version}…")
    sh(sh_env, "cd #{repo_root} && ci/local-release-check.sh #{tag} #{sign_flags.join(' ')}")

    ipa_path = File.join(repo_root, "build", IPA_NAME_PATTERN % version)
    pkg_path = File.join(repo_root, "build", PKG_NAME_PATTERN % version)
    if do_ios
      UI.user_error!("IPA missing at #{ipa_path}") unless File.exist?(ipa_path)
    end
    if do_macos
      UI.user_error!("pkg missing at #{pkg_path}") unless File.exist?(pkg_path)
    end

    api_key = asc_api_key

    if skip_upload
      UI.important("Step 3/6: Skipping iOS TestFlight upload (skip_upload:true)")  if do_ios
      UI.important("Step 4/6: Skipping macOS TestFlight upload (skip_upload:true)") if do_macos
    else
      # Build the optional/defensive pilot options for this build.
      #
      # RELEASE_CHANGELOG is NOT applied here — fastlane pilot 2.233.1's
      # set_changelog path is broken for new builds with no pre-existing
      # BetaBuildLocalization (the inner update_localized_build_review at
      # build_manager.rb:560-588 iterates an empty hash and no-ops, but
      # logs success regardless). The annotate_testflight_whats_new step
      # below (Step 5/6) handles changelog annotation via direct
      # Spaceship POST/PATCH. See docs/CONTINUOUS-VALIDATION.md G15.
      #
      # No notify_external_testers / distribute_external overrides — pilot's
      # defaults match what we want (distribute_external defaults to false;
      # notify_external_testers defaults to ASC's server-side default).
      # Canary builds end up in "Internal Testing" (App Manager users), which
      # is fine — for the smoketest the count is 0; for real forks, internal
      # testers are typically the developers themselves who can ignore canary
      # builds in TestFlight UI. Letting pilot defaults apply means the
      # canary path mirrors a real fork's release.yml behavior more closely
      # → catches drift in default-pilot behavior too.
      # Pilot uploads block until ASC has fully ingested the build (no
      # skip_waiting_for_build_processing here). Adds 2-5 min per platform
      # to ship duration, but eliminates the indexing-race window that
      # made the annotate_testflight_whats_new step (Step 5/6 below) flaky:
      # when pilot returned early, annotate's poll had to wait up to 10 min
      # for ASC to surface the just-uploaded build, and on rapid-fire ships
      # that ceiling was sometimes blown — leaving a populated binary on
      # TestFlight with empty "What to Test". Blocking here is cheaper than
      # debugging an empty whatsNew after-the-fact.
      if do_ios
        UI.message("Step 3/6: Uploading iOS .ipa to TestFlight (waits for ASC ingest)…")
        pilot_with_retry(api_key: api_key, ipa: ipa_path)
      end
      if do_macos
        UI.message("Step 4/6: Uploading macOS .pkg to TestFlight (waits for ASC ingest)…")
        pilot_with_retry(api_key: api_key, pkg: pkg_path)
      end
    end

    # Step 5/6: annotate "What to Test" via direct Spaceship POST/PATCH.
    # Workaround for fastlane pilot 2.233.1's broken set_changelog
    # (G15 in docs/CONTINUOUS-VALIDATION.md). Skipped on dry runs and
    # when explicitly opted out via skip_changelog:true.
    if dry_run
      UI.important("Step 5/6: Skipping What to Test annotation (dry run).")
    elsif skip_changelog
      UI.important("Step 5/6: Skipping What to Test annotation (skip_changelog:true).")
    else
      changelog = changelog_text(repo_root, tag, changelog_arg)
      if changelog.strip.empty?
        UI.important("Step 5/6: No changelog text resolved; skipping What to Test annotation.")
      else
        # parse_release_tag handles all three tag formats:
        #   v1.0.0+5                  → marketing=1.0.0
        #   v0.YYYY.WW-canary-N-gen   → marketing=0.YYYY.WW
        #   v2026.19.1357             → marketing=2026.19.1357
        # The OLD `version.split("-", 2).first` did NOT strip the `+5` suffix,
        # so passing tag `v0.0.1+1` made marketing_version become "0.0.1+1",
        # which ASC's Build.all(version:) filter URL-encoded as "0.0.1 1"
        # and barfed with a 500 (#173 regression from #172).
        tag_marketing, _ = parse_release_tag(tag)
        marketing_version = ENV["RELEASE_MARKETING_VERSION"].to_s.strip.empty? ? tag_marketing : ENV["RELEASE_MARKETING_VERSION"]
        expected_count    = (do_ios && do_macos) ? 2 : 1
        UI.message("Step 5/6: Annotating What to Test in TestFlight (version=#{marketing_version}, after #{ship_start_time.iso8601}, expecting #{expected_count} build record#{expected_count == 1 ? '' : 's'})…")
        annotate_testflight_whats_new(
          app_identifier:    APP_IDENTIFIER,
          marketing_version: marketing_version,
          ship_start_time:   ship_start_time,
          changelog:         changelog,
          expected_count:    expected_count,
        )
      end
    end

    if skip_tag
      UI.important("Step 6/6: Skipping tag push (skip_tag:true). Run 'git tag #{tag} && git push origin #{tag}' manually when ready.")
    else
      UI.message("Step 6/6: Tagging and pushing #{tag}…")
      sh("cd #{repo_root} && git tag #{tag} && git push origin #{tag}")
    end

    UI.success("#{tag} is live on TestFlight (#{active_platforms.join(' + ')}).")
  end

  desc "Capture App Store screenshots (iOS + macOS via ci/take-screenshots.sh)"
  desc "Output: fastlane/screenshots/en-US/*.png"
  desc "Usage: fastlane take_screenshots"
  # Renamed from `capture_screenshots` to avoid the lane-vs-built-in-action collision.
  lane :take_screenshots do
    repo_root = File.expand_path("..", __dir__)
    sh("cd #{repo_root} && ci/take-screenshots.sh")
    UI.success("Screenshots in fastlane/screenshots/. Inspect, then run upload_screenshots (ios/mac).")
  end

  desc "Upload iOS screenshots to App Store Connect (no submit, no metadata change)"
  lane :upload_screenshots do
    deliver(
      api_key:                  asc_api_key,
      app_identifier:           APP_IDENTIFIER,
      platform:                 :ios,
      skip_metadata:            true,
      skip_binary_upload:       true,
      skip_screenshots:         false,
      overwrite_screenshots:    true,
      force:                    true,
      submit_for_review:        false,
      automatic_release:        false,
      precheck_include_in_app_purchases: false
    )
    UI.success("iOS screenshots uploaded. Submit via fastlane ios submit_for_review when ready.")
  end

  desc "Upload iOS metadata text (name/subtitle/description/keywords/URLs) without screenshots or binary"
  lane :upload_metadata do
    do_upload_metadata(platform: :ios)
  end

  desc "Submit the latest iOS TestFlight build for App Store review"
  desc "Prerequisites: take_screenshots + upload_screenshots + upload_metadata done; build is in 'Ready for Review' state"
  lane :submit_for_review do
    do_submit_for_review(platform: :ios, submit: true)
  end

  desc "Stage iOS for App Store review WITHOUT clicking Submit (review in ASC web UI, then click Submit yourself)"
  desc "Same as submit_for_review but leaves version in 'Prepare for Submission' state — recommended for early releases"
  lane :stage_for_review do
    do_submit_for_review(platform: :ios, submit: false)
  end
end

# ─── macOS lanes ──────────────────────────────────────────────────────────────
# iOS + macOS apps share the same bundle id (Universal Purchase). App Store
# Connect maintains separate AppStoreVersion records per platform — the same
# metadata files are reused across both platforms by default.
platform :mac do
  desc "Upload macOS metadata text"
  lane :upload_metadata do
    do_upload_metadata(platform: :osx)
  end

  desc "Upload macOS screenshots in fastlane/screenshots/en-US/ to App Store Connect"
  # deliver infers macOS device class from PNG dimensions
  # (2880×1800 → MAC_2880, 1440×900 → MAC_1440, etc.).
  lane :upload_screenshots do
    deliver(
      api_key:                  asc_api_key,
      app_identifier:           APP_IDENTIFIER,
      platform:                 "osx",
      skip_metadata:            true,
      skip_binary_upload:       true,
      skip_screenshots:         false,
      overwrite_screenshots:    true,
      force:                    true,
      submit_for_review:        false,
      automatic_release:        false,
      precheck_include_in_app_purchases: false
    )
    UI.success("macOS screenshots uploaded. Submit via fastlane mac submit_for_review when ready.")
  end

  desc "Submit the latest macOS TestFlight build for App Store review"
  lane :submit_for_review do
    do_submit_for_review(platform: :osx, submit: true)
  end

  desc "Stage macOS for App Store review WITHOUT clicking Submit (review in ASC web UI, then click Submit yourself)"
  lane :stage_for_review do
    do_submit_for_review(platform: :osx, submit: false)
  end
end

# ─── Fork extension point ─────────────────────────────────────────────────────
#
# Forks extend the template with their own lanes, hooks, and overrides via
# fastlane/Fastfile.local — a fork-owned, tracked file that survives upstream
# syncs without merge conflicts. The template ships fastlane/Fastfile.local.example
# with copy-pasteable patterns adapted from https://github.com/fastlane/examples:
#
#   • after_all + error hooks for Slack / Discord / OneSignal notifications
#   • override_lane :release to add post-ship steps (dSYM → Crashlytics,
#     bumping internal trackers, posting to release-engineering channels)
#   • new lanes for non-App-Store distribution (Firebase App Distribution,
#     Diawi, TestFairy, ad-hoc enterprise)
#   • custom actions dropped into fastlane/actions/ (fastlane auto-loads them)
#
# How fastlane composes imports
# (https://docs.fastlane.tools/advanced/Fastfile/): imported files merge
# into a single namespace. Helpers + constants defined above —
# APP_NAME, APP_IDENTIFIER, IOS_SCHEME, MACOS_SCHEME, asc_api_key,
# pilot_with_retry, changelog_text — are all callable from Fastfile.local.
#
# Hook slots: this template claims `before_all` (setup_ci in CI mode +
# asc_api_key bootstrap). `after_all` and `error` are intentionally NOT
# defined here so forks can claim them freely without clobbering template
# behavior. To extend `before_all`, override the lane you actually want
# to extend (`override_lane :release`) instead — fastlane's `before_all`
# is last-write-wins, so overriding it from Fastfile.local would silently
# drop the template's ASC bootstrap.
#
# Imported at the BOTTOM (not the top) so `override_lane` works: the
# original lane must be defined before the override replaces it.
_local = File.join(File.dirname(__FILE__), "Fastfile.local")
import _local if File.exist?(_local)
